{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI卫士",
  "version": "0.1.0",
  "identifier": "io.aiguard.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI卫士（AI Guard）v0.1.0 — Windows 宿主机双环境安全主控中心",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:17900; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.gstatic.com"
    }
  }
}
